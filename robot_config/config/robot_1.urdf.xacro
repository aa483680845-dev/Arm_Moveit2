<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_1">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robot_1 urdf file -->
    <xacro:include filename="$(find robot_description)/urdf/robot_1.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robot_1.ros2_control.xacro" />


    <xacro:robot_1_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
